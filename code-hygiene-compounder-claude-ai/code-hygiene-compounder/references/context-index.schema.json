{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Great Code Hygiene context index",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "root",
    "files"
  ],
  "properties": {
    "version": {
      "const": "2"
    },
    "generated_at": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "domains",
          "read_when",
          "sha256",
          "lines",
          "words"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "read_when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "lines": {
            "type": "integer",
            "minimum": 0
          },
          "words": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
